{
  "name": "calc-18-qtd-negativa",
  "method": "POST",
  "path": "/carrinho/calcular",
  "request": {
    "itens": [
      {
        "produtoId": "P001",
        "quantidade": -2
      }
    ]
  },
  "status": 422,
  "response": {
    "erro": {
      "codigo": "QUANTIDADE_INVALIDA",
      "mensagem": "A quantidade deve ser um número inteiro maior ou igual a 1.",
      "campo": "itens[0].quantidade"
    }
  }
}